{
  "name": "fault-affinity",
  "version": "1.0.0",
  "private": true,
  "description": "Linux harness for bounded, resumable CPU-affinity fault diagnostics",
  "type": "module",
  "bin": {
    "fault-affinity": "./fault-affinity.mjs"
  },
  "scripts": {
    "test": "bash diagnose-lib/tests/run-tests.sh",
    "fault-affinity": "node fault-affinity.mjs",
    "repro": "node repro.mjs",
    "repro:long": "node repro.mjs 16 100",
    "repro:sequential": "node repro.mjs 1 50",
    "load:aba": "node load-state-aba.mjs",
    "load:gdb": "node load-state-aba.mjs --mode gdb",
    "load:node-aba": "node load-state-aba.mjs --mode node-aba",
    "load:node-matrix": "node load-state-aba.mjs --mode node-matrix",
    "check:deno": "deno check deno-repro.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4"
  },
  "engines": {
    "node": ">=24"
  }
}
